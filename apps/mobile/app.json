{
  "expo": {
    "name": "ZK Identity Verifier",
    "slug": "zkproof-verifier",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "zkidentity",
    "assetBundlePatterns": ["assets/**/*"],
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zkidentity.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is used to scan QR codes for wallet connection and to help you read your passport MRZ for NFC access.",
        "NFCReaderUsageDescription": "NFC is used to read your passport chip for identity verification. Your passport data never leaves this device.",
        "LSApplicationQueriesSchemes": [
          "metamask",
          "trust",
          "cbwallet",
          "rainbow",
          "zerion"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.zkidentity.app",
      "permissions": [
        "android.permission.NFC",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Camera is used to scan QR codes for wallet connection and to help you read your passport MRZ for NFC access."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0",
            "newArchEnabled": true
          },
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "newArchEnabled": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
