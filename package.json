{
  "name": "sigil",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "postinstall": "node -e \"const fs=require('fs'),p='node_modules/mopro-ffi/src/generated/zkpassport_circuits.ts';if(fs.existsSync(p)){let c=fs.readFileSync(p,'utf8');c=c.replace('bindingsContractVersion = 30','bindingsContractVersion = 29');fs.writeFileSync(p,c);}\"",
    "mobile": "pnpm --filter mobile start",
    "mobile:ios": "pnpm --filter mobile ios",
    "mobile:android": "pnpm --filter mobile android",
    "contracts:build": "pnpm --filter contracts build",
    "contracts:sync-abi": "node scripts/sync-abi.mjs",
    "contracts:test": "pnpm --filter contracts test",
    "typecheck": "pnpm --filter mobile typecheck"
  },
  "devDependencies": {
    "@zkpassport/poseidon2": "^0.6.2",
    "typescript": "^5.5.0"
  },
  "pnpm": {
    "overrides": {
      "viem": "^2.23.0",
      "valtio": "2.1.8",
      "@walletconnect/universal-provider": "2.21.10",
      "commander": "^7.2.0"
    },
    "onlyBuiltDependencies": [
      "bufferutil",
      "keccak",
      "utf-8-validate"
    ],
    "patchedDependencies": {
      "react-native@0.81.5": "patches/react-native@0.81.5.patch"
    }
  }
}
